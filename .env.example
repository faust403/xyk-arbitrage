# ============================================================================
# arbbot — production .env.example
# ----------------------------------------------------------------------------
# Last updated 2026-05-21 to reflect the live Frankfurt EC2 deployment:
#   - Helius Business plan + Gatekeeper (beta.helius-rpc.com)
#   - LaserStream gRPC subscriptions
#   - Native Rust ShredStream subscriber (--features shredstream)
#   - Multi-ALT Jupiter+flash path
#   - 4 production binaries: arb-scout, kamino-hunter, marginfi-hunter,
#     pumpswap-watcher
#
# Sections below are ordered by criticality.  Lines marked [REQUIRED] must be
# filled in before any binary can boot; [OPTIONAL] vars have sane defaults.
# ============================================================================

# ============================================================================
# Helius RPC + WSS + Shred Delivery
# ============================================================================
# [REQUIRED] Helius API key — sign up at https://dashboard.helius.dev
HELIUS_API_KEY=put-your-key-here

# [OPTIONAL] RPC host override.  Default `mainnet.helius-rpc.com` (Cloudflare).
# Set to `beta.helius-rpc.com` for Gatekeeper edge gateway — ~10x faster RPC
# (28ms → 2.2ms median keep-alive getSlot, measured 2026-05-17 from Frankfurt).
# All 4 production bins read this via arb_scout::rpc::helius_rpc_url().
HELIUS_RPC_HOST=beta.helius-rpc.com

# Atlas Enhanced WSS — bundled with Developer plan and up.  Used by arb-scout
# for pool account subscriptions (Phase 6A backend).
HELIUS_ENHANCED_WSS_URL=wss://atlas-mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# LaserStream gRPC — Yellowstone protocol, requires Helius Business plan.
# Used by all 3 hunters + arb-scout's Phase 6B backend.  Frankfurt region.
LASERSTREAM_GRPC_URL=https://laserstream-mainnet-fra.helius-rpc.com:443

# Helius Sender — atomic-revert-aware sendTransaction with TPU forwarding.
# Empty = falls back to standard sendTransaction.
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
HELIUS_SENDER_TIP_LAMPORTS=10000

# ============================================================================
# Jito (block engine + tip accounts)
# ============================================================================
JITO_EXPLORER_URL=https://bundles.jito.wtf
JITO_BLOCK_ENGINE_URL=https://frankfurt.mainnet.block-engine.jito.wtf
JITO_BLOCK_ENGINE_URLS=https://frankfurt.mainnet.block-engine.jito.wtf,https://amsterdam.mainnet.block-engine.jito.wtf

# ============================================================================
# Jupiter aggregator
# ============================================================================
# [REQUIRED] Launch plan API key — https://portal.jup.ag
JUPITER_API_KEY=put-your-jupiter-key-here
# Use api.jup.ag (Launch plan) for 600+ rpm; lite-api.jup.ag throttles at 5/sec.
JUPITER_ENDPOINT_BASE=https://api.jup.ag/swap/v1
# Restrict intermediates to USDC/USDT/SOL/mSOL bridges?  false = exotic routing
JUPITER_RESTRICT_INTERMEDIATES=false
# Polling worker (arb-scout): true uses Jupiter as the arb detector via 21
# curated intermediates cycled at JUPITER_POLL_INTERVAL_MS.  500ms = ~5 q/sec
# (well under Launch plan rate-limit), 250ms = ~10/sec (hits rate-limit).
JUPITER_POLL_ENABLED=true
JUPITER_POLL_INTERVAL_MS=500

# ============================================================================
# ShredStream (Jito ShredStream Proxy on localhost)
# ============================================================================
# [OPTIONAL] Override the default `http://localhost:9000` shredstream-proxy
# endpoint.  Bins read this when built with `--features shredstream`.
SHREDSTREAM_GRPC_URL=http://localhost:9000
# [OPTIONAL] Disable all shred fast-paths (LaserStream only).  Useful for
# debugging which path is firing.
SHRED_ALERT_DISABLE=false

# ============================================================================
# Wallet — CRITICAL.  Keypair is what controls every dollar the bot can move.
# ============================================================================
# JSON array form: [byte0, byte1, ..., byte63].  64 bytes total (priv+pub).
# Per the 2026-05-12 incident: NEVER paste this into any external "config"
# or "runner" tool.  Keypair lives ONLY in env + offline backup.
SOLANA_KEYPAIR_JSON=[]
# Local Windows-only fallback (forward slashes only — dotenvy parser quirk).
SOLANA_KEYPAIR_PATH=

# Minimum SOL lamports to keep in wallet (gas reserve).  Default 0.1 SOL.
MIN_SOL_RESERVE_LAMPORTS=100000000

# ============================================================================
# Executor — Jupiter+flash arb path (arb-scout's primary fire path)
# ============================================================================
EXECUTOR_LIVE=true
EXECUTOR_USE_JITO=false
# Probe size in USDC base units (6 decimals).  10M = $10.  Increasing helps
# capture wider spreads but increases AMM slippage on shallow pools.
EXECUTOR_PROBE_AMOUNT_USDC=10000000
# Minimum net profit (USDC base units) to clear before sending.  1000 = $0.001
# (boundary-catching mode).  10000 = $0.01 (safe).
EXECUTOR_MIN_PROFIT_USDC=1000
EXECUTOR_MAX_DAILY_LOSS_USDC=5000000
EXECUTOR_SLIPPAGE_BPS=200
EXECUTOR_JITO_TIP_LAMPORTS=10000
EXECUTOR_MIN_INTERVAL_MS=50
EXECUTOR_SAMPLE_ONE_IN_N=1
EXECUTOR_TIP_PROFIT_PCT=50
EXECUTOR_INCLUDE_DEXES=Raydium,Raydium CLMM,Whirlpool,Meteora DLMM,Phoenix,Lifinity V2,Pump.fun Amm
# Cap on Jupiter `maxAccounts`.  64 lets multi-pool routes through but produces
# 1832-2276 byte txs (over 1232 v0 limit) unless multi-ALT is configured.
EXECUTOR_MAX_ACCOUNTS=64
EXECUTOR_SKIP_PROFIT_GATE=false
# Primary ALT (256 entries).  Deploy via bin/alt-deploy-* helpers.
EXECUTOR_NATIVE_ALT=put-primary-alt-pubkey-here
# Secondary ALT — picked up by execute_flash_jupiter to extend compressible
# address budget to 512.  Without this, Jupiter+flash txs overflow 1232b.
EXECUTOR_NATIVE_ALT2=put-secondary-alt-pubkey-here
# Pyth ALT — Solend liquidator uses this to compress 85+ Pyth oracle refs.
EXECUTOR_PYTH_ALT=put-pyth-alt-pubkey-here
# MarginFi liquidator dedicated ALT (45 banks × 7 refs ≈ 230 addrs).
EXECUTOR_MARGINFI_ALT=put-marginfi-alt-pubkey-here

# ============================================================================
# Native executor (pool-state arb path, parallel to Jupiter)
# ============================================================================
NATIVE_DISPATCH_DISABLED=false
NATIVE_INLINE_EXECUTE=true
NATIVE_FAST_MODE=true
NATIVE_MAX_CONCURRENT=16
NATIVE_MAX_HOPS=3
NATIVE_FLASH_MAX_HOPS=3
# Submission path: "tpu" = direct UDP to next leader (5ms), "helius" = Sender (50ms).
NATIVE_SUBMISSION_PATH=tpu
# Sim preflight before send — keep TRUE; previously bled tips when set false.
NATIVE_SKIP_PREFLIGHT_SIM=false
# Per-leg quote haircuts.  25bp = halved from 50bp default; was 100bp which
# was eating 200bp/2-hop arb before sim and killing every spread.
NATIVE_AMM_QUOTE_HAIRCUT_BPS=25
NATIVE_CLMM_QUOTE_HAIRCUT_BPS=25
# Native probe sizes (USDC base units).  Used when flash is unavailable.
NATIVE_NO_FLASH_PROBE_USDC=10000000
NATIVE_DYNAMIC_PROBE_MIN_USDC=100000
NATIVE_DYNAMIC_PROBE_MAX_USDC=50000000
NATIVE_DYNAMIC_PROBE_MAX_TICKS=2
NATIVE_BUFFER_CAPACITY=1024
NATIVE_BUFFER_MAX_AGE_MS=5000
NATIVE_BELOW_MIN_LOG_EVERY=100
NATIVE_KAMINO_HEALTH_MARGIN_BPS=100
NATIVE_KAMINO_MAX_STALE_SLOTS=10
# Disable Obric quoter — its mult_x/mult_y feeds run stale Pyth and quotes
# 3% off-mid, producing 81% of below_min noise.  Keep TRUE in production.
NATIVE_DISABLE_OBRIC=true
NATIVE_DISABLE_METEORA_DLMM=false

# ============================================================================
# Flash loan provider (MarginFi v2 = 0bps fee)
# ============================================================================
FLASH_LOAN_ENABLED=true
FLASH_LOAN_PROVIDER=marginfi
MARGINFI_ACCOUNT=put-your-marginfi-account-here
MARGINFI_USDC_LIQUIDITY_VAULT=put-marginfi-usdc-vault-here
MARGINFI_USDT_LIQUIDITY_VAULT=put-marginfi-usdt-vault-here
USDT_ALTERNATION_ENABLED=false
SOL_ALTERNATION_ENABLED=false

# ============================================================================
# Scout — opportunity detector + Jupiter polling worker
# ============================================================================
SCOUT_PROBE_AMOUNT_USDC=5000000000
SCOUT_PROBE_AMOUNT_SOL_LAMPORTS=1000000000
SCOUT_PRIORITY_FEE_MICROLAMPORTS_PER_CU=50000
SCOUT_COMPUTE_UNIT_LIMIT=600000
SCOUT_BASE_TIP_LAMPORTS=10000
SCOUT_PROFIT_TIP_PERCENT=50
SCOUT_MAX_HOPS=4

# DLMM quoter precision (max bins to walk per leg).  Higher = slower + more accurate.
CLMM_QUOTE_MAX_TICKS_PER_LEG=12
WHIRLPOOL_QUOTE_MAX_TICKS_PER_LEG=12
CLMM_LEAVE_UNITS=10
WHIRLPOOL_LEAVE_UNITS=10

# Yellowstone transaction stream — predictive pool-state pre-feed.
YELLOWSTONE_TX_STREAM_ENABLED=true

# ============================================================================
# Mode + accumulator
# ============================================================================
RUN_MODE=mainnet
SOL_ACCUMULATOR_ENABLED=true
SOL_ACCUMULATOR_INTERVAL_SECS=600
SOL_ACCUMULATOR_MIN_SWAP_USDC_BASE=5000000
SOL_ACCUMULATOR_THRESHOLD_USDC_BASE=200000000

# Cross-stable arb (USDC/USDT/PYUSD depeg sniper)
CROSS_STABLE_ARB_ENABLED=true
CROSS_STABLE_CASH_ENABLED=false
CROSS_STABLE_POLL_INTERVAL_MS=1000
CROSS_STABLE_PROBE_USD_BASE=10000000

# ============================================================================
# pumpswap-watcher (graduation arber)
# ============================================================================
PUMPSWAP_PROBE_LAMPORTS=2000000000
PUMPSWAP_JITO_TIP_LAMPORTS=20000
PUMPSWAP_MIN_PROFIT_LAMPORTS=10000
PUMPSWAP_FRESH_MAX_AGE_SECS=3600
PUMPSWAP_MIN_QUOTE_LAMPORTS=1000000000
PUMPSWAP_AUTOFIRE=true
PUMPSWAP_USE_TPU=true
PUMPSWAP_TPU_FANOUT=4
PUMPSWAP_SLIPPAGE_BPS=500
PUMPSWAP_PROBE_PCT_VAULT_BPS=500

# ============================================================================
# kamino-hunter
# ============================================================================
KAMINO_HUNT_MIN_DEBT_USD=50
KAMINO_JUPITER_MAX_ACCOUNTS=40
KAMINO_MAX_FLASH_USD=5000

# ============================================================================
# marginfi-hunter
# ============================================================================
MARGINFI_HUNT_MIN_DEBT_USD=50
MARGINFI_FIRE_WORKERS=2

# ============================================================================
# Solend liquidator
# ============================================================================
SOLEND_LIQUIDATOR_ENABLED=true
SOLEND_LIQUIDATOR_LIVE=true
SOLEND_LIQUIDATOR_FRESH_ONLY=true
SOLEND_LIQUIDATOR_SKIP_SIM=false
SOLEND_LIQUIDATOR_MIN_PROFIT_USD=0.10
SOLEND_LIQUIDATOR_MAX_BONUS_USD=10000
SOLEND_LIQUIDATOR_FLASH_LOAN_USD=10000
SOLEND_LIQUIDATOR_TAKE=10
SOLEND_LIQUIDATOR_SKIP_TOP=0
SOLEND_LIVE_RATIO_THRESHOLD=1.0
SOLEND_POLL_SECS=120
SOLEND_PRIORITY_MICRO_LAMPORTS=10000
SOLEND_JITO_TIP_LAMPORTS=20000
SOLEND_USE_JITO_BUNDLE=false
SOLEND_SHRED_BRIDGE_ENABLED=true
SOLEND_FLASH_LOAN_FEE_BPS=9
# Solend reserve/oracle addresses — verified on-chain 2026-05-10.  Set carefully.
SOLEND_LENDING_MARKET=4UpD2fh7xH3VP9QQaXtsS1YY3bxzWhtfpks7FatyKvdY
SOLEND_LENDING_MARKET_AUTHORITY=put-derived-authority-here
SOLEND_USDC_RESERVE=BgxfHJDzm44T7XG68MYKx7YisTjZu73tVovyZSjJMpmw
SOLEND_USDC_RESERVE_LIQUIDITY_SUPPLY=put-supply-account-here
SOLEND_USDC_PYTH_ORACLE=put-pyth-oracle-here
SOLEND_USDC_SWITCHBOARD_ORACLE=nu11111111111111111111111111111111111111111
SOLEND_USDC_FEE_RECEIVER=put-fee-receiver-here
SOLEND_USDC_HOST_FEE_RECEIVER=put-host-fee-receiver-here

# ============================================================================
# pump.fun sniper (HODL / buy-only mode)
# ============================================================================
PUMP_FUN_DETECTOR_ENABLED=true
PUMP_FUN_EXECUTE_ENABLED=true
PUMP_FUN_HODL_MODE=true
PUMP_FUN_BUNDLE_HODL=false
PUMP_FUN_GRAD_ARB_ENABLED=true
PUMP_FUN_BUY_LAMPORTS=10000000
PUMP_FUN_TOTAL_BUDGET_LAMPORTS=1000000000
PUMP_FUN_BUDGET_STATE_PATH=/var/lib/arbbot/pump_fun_budget.json
PUMP_FUN_BUY_DELAY_MS=0
PUMP_FUN_POST_BUY_DELAY_MS=500
PUMP_FUN_BUY_MIN_INTERVAL_MS=200
PUMP_FUN_BATCH_LIMIT=5
PUMP_FUN_MAX_POSITIONS=20
PUMP_FUN_POLL_SECS=30
PUMP_FUN_POLL_SELL=false
PUMP_FUN_SKIP_MAYHEM=false
PUMP_FUN_TIMEOUT_SECS=300
PUMP_FUN_TP_PCT=50
PUMP_FUN_TP_MULTIPLIER=2.0
PUMP_FUN_SL_PCT=30
PUMP_FUN_GRAD_HOLD_SECS=600
PUMP_FUN_GRAD_INDEX_TIMEOUT_SECS=60
PUMP_FUN_JITO_BUNDLE_TIP_LAMPORTS=20000
SELL_ALL_PUMP_ON_BOOT=false

# ============================================================================
# Axiom-style trending sniper (on-chain trending detector)
# ============================================================================
AXIOM_TRENDING_ENABLED=true
AXIOM_TRENDING_MIN_BUYS=8
AXIOM_TRENDING_COOLDOWN_SECS=60
AXIOM_TRENDING_BUY_LAMPORTS=10000000

# ============================================================================
# Telegram (operator alerts + /status + /pools commands)
# ============================================================================
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
TELEGRAM_OPERATOR_CHAT_ID=put-your-chat-id-here

# ============================================================================
# Logging
# ============================================================================
RUST_LOG=info
SCOUT_LOG_DIR=/var/log/arbbot
